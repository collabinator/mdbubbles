{
  "name": "mdbub",
  "version": "0.5.0",
  "description": "Terminal-first interactive mindmap CLI tool with extended markdown support",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "mdbub": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.{ts,tsx}'"
  },
  "keywords": [
    "cli",
    "terminal",
    "mindmap",
    "markdown",
    "productivity",
    "tui",
    "ink",
    "react"
  ],
  "author": "dudash",
  "license": "Apache-2.0",
  "homepage": "https://github.com/collabinator/mdbubbles",
  "repository": {
    "type": "git",
    "url": "https://github.com/collabinator/mdbubbles.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.0",
    "ink": "^6.7.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
